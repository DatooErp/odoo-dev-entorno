# Copiar a .env (permisos 600) y rellenar. No subir nunca el .env al repositorio.
PG_PASSWORD=
ODOO_MASTER_PASSWORD=
PANEL_SECRET_KEY=
# Primer usuario de Datoo (usuario «datoo»). Su nombre y correo son su firma de git.
PANEL_DATOO_PASSWORD=
PANEL_DATOO_NAME=
PANEL_DATOO_EMAIL=
# Grupo del socket de Docker en el servidor: stat -c %g /var/run/docker.sock
DOCKER_GID=
# Dirección pública del Odoo de desarrollo y nombre que muestra el panel.
PUBLIC_URL=https://desarrollo.example.com
ENV_NAME=Entorno de desarrollo
# Vacío si el panel tiene nombre propio; /dev si cuelga de la URL de Odoo.
PANEL_PREFIX=
# Nombre del entorno en la aplicación de ChatGPT (sin espacios).
ENV_HOSTNAME=odoo-dev
# Identificador corto del entorno: forma parte de los nombres de rama
# (desarrollo/<ENV_SLUG>, solicitud/<ENV_SLUG>-<usuario>-<n>).
ENV_SLUG=entorno
# Base de datos de desarrollo de la empresa (una por entorno).
DEV_DB=
# Origen de la copia de producción: usuario@servidor con la clave restringida
# y nombre de la base de datos de producción.
SOURCE_SSH=
SOURCE_DB=
# Repositorio de los módulos y, opcional, token para abrir pull requests.
GITHUB_REPO=DatooErp/datoov16
GITHUB_TOKEN=
# Secreto de las ventanas de terminal: el mismo valor en el fichero
# terminal.secret (propietario root, permisos 600).
TERMINAL_SECRET=
