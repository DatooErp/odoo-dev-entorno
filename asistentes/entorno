#!/usr/bin/env python3
"""Órdenes del entorno de desarrollo para los asistentes.

Piden al panel que actúe sobre el Odoo de desarrollo: los asistentes no
tienen acceso directo a Odoo ni a Docker.
"""
import json
import os
import sys
import time
import urllib.error
import urllib.request

PANEL = os.environ.get("PANEL_URL", "http://panel:8000").rstrip("/")
USO = """Uso:
  entorno actualizar <modulo[,modulo...]>   actualiza módulos y reinicia Odoo
  entorno instalar <modulo[,modulo...]>     instala módulos y reinicia Odoo
                                            (con varias bases de datos: --bd <nombre>)
  entorno desinstalar <modulo[,modulo...]>  muestra qué se desinstalaría, con los
                                            módulos dependientes; con --confirmar, lo hace
  entorno reiniciar                         reinicia Odoo (cambios solo de Python)
  entorno registro [lineas]                 últimas líneas del registro de Odoo
  entorno estado                            estado de Odoo y tus bases de datos
  entorno pendientes                        tus commits aún sin solicitar
  entorno solicitar "<título>" ["<descripción>"] [--commits sha,sha]
                                            solicita el paso a producción
  entorno solicitudes [número]              tus solicitudes: estado, nota de Datoo, informe
  entorno retirar <número>                  retira una solicitud pendiente para rehacerla

Los cambios de un frontend React no necesitan nada de esto: se compilan con
«npm run build» en la carpeta frontend del módulo y se ven al recargar."""


def call(path, data=None):
    try:
        token = open(os.path.expanduser("~/.entorno-token")).read().strip()
    except OSError:
        sys.exit("No hay credencial del entorno. Entra en el panel para que se genere.")
    req = urllib.request.Request(PANEL + "/api/asistente/" + path, method="POST" if data is not None else "GET",
                                 data=json.dumps(data).encode() if data is not None else None,
                                 headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            return r.status, json.load(r)
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.load(e)
        except Exception:
            return e.code, {"error": f"El panel ha respondido {e.code}."}
    except OSError as e:
        sys.exit(f"No se puede contactar con el panel: {e}")


def run(action, data):
    for attempt in range(40):  # si hay otra operación en curso, espera su turno
        status, body = call(action, data)
        if status != 409:
            break
        if attempt == 0:
            print("Hay otra operación en curso en el entorno. Esperando turno...", flush=True)
        time.sleep(15)
    if status != 200:
        sys.exit(body.get("error", f"Error {status}"))
    if "hecho" in body:  # operación inmediata, sin tarea que seguir
        print(body["hecho"])
        return
    seen = 0
    while True:
        status, job = call(f"tarea/{body['tarea']}?desde={seen}")
        if status != 200:
            sys.exit(job.get("error", f"Error {status}"))
        for line in job["lineas"]:
            print(line, flush=True)
        seen = job["total"]
        if job["estado"] != "en curso":
            print(f"Resultado: {job['estado']}")
            sys.exit(0 if job["estado"] == "correcto" else 1)
        time.sleep(2)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "ayuda"):
        print(USO)
    elif args[0] in ("actualizar", "instalar") and len(args) in (2, 4):
        bd = ""
        if len(args) == 4:
            if "--bd" not in args[1:]:
                sys.exit(USO)
            i = args.index("--bd")
            bd = args[i + 1] if i + 1 < len(args) else ""
            args = args[:i] + args[i + 2:]
        run(args[0], {"modulos": args[1], "bd": bd})
    elif args[0] == "desinstalar" and len(args) >= 2:
        rest, confirm, bd = args[1:], False, ""
        if "--confirmar" in rest:
            confirm = True
            rest.remove("--confirmar")
        if "--bd" in rest:
            i = rest.index("--bd")
            bd = "".join(rest[i + 1:i + 2])
            rest = rest[:i] + rest[i + 2:]
        if len(rest) != 1:
            sys.exit(USO)
        run("desinstalar", {"modulos": rest[0], "bd": bd, "confirmar": confirm})
    elif args[0] == "retirar" and len(args) == 2 and args[1].isdigit():
        run("retirar", {"id": int(args[1])})
    elif args[0] == "solicitudes" and len(args) <= 2:
        status, body = call("solicitudes" + (f"?id={args[1]}" if len(args) == 2 and args[1].isdigit() else ""))
        print(body.get("texto") or body.get("error", f"Error {status}"))
        sys.exit(0 if status == 200 else 1)
    elif args[0] == "reiniciar" and len(args) == 1:
        run("reiniciar", {})
    elif args[0] == "registro" and len(args) <= 2:
        status, body = call("registro?lineas=" + (args[1] if len(args) == 2 else "200"))
        print(body.get("texto") or body.get("error", f"Error {status}"))
        sys.exit(0 if status == 200 else 1)
    elif args[0] == "solicitar" and len(args) >= 2:
        rest, commits = args[1:], []
        if "--commits" in rest:
            i = rest.index("--commits")
            commits = [c for c in "".join(rest[i + 1:i + 2]).split(",") if c]
            rest = rest[:i] + rest[i + 2:]
        if not 1 <= len(rest) <= 2:
            sys.exit(USO)
        run("solicitar", {"titulo": rest[0], "descripcion": rest[1] if len(rest) == 2 else "", "commits": commits})
    elif args[0] in ("estado", "pendientes") and len(args) == 1:
        status, body = call(args[0])
        print(body.get("texto") or body.get("error", f"Error {status}"))
        sys.exit(0 if status == 200 else 1)
    else:
        sys.exit(USO)


main()
